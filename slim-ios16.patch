-        vm_address_t hole_address = prev_vme_end;
-        vm_size_t hole_size = address - prev_vme_end;
-
-        if (prev_vme_end < min_address) {
-            goto next_vm_region;
-        }
-
-        if (found_target_hole) {
-            if (hole_size >= (smith_total_size + pages(1))) {
